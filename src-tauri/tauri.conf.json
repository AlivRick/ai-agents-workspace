{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentspace",
  "version": "0.1.0",
  "identifier": "dev.thuan.agentspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agentspace",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "publisher": "HUTECH",
    "copyright": "© HUTECH",
    "shortDescription": "Run your coding agents side by side",
    "longDescription": "Agentspace — a desktop app that runs Claude Code, Codex and plain shells side by side, grouped into tasks per workspace, with the skills, memory and usage behind them. It runs the CLIs already installed on your machine, under your own account.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "Vietnamese",
          "English"
        ]
      }
    }
  }
}