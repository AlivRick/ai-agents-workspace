{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentspace",
  "version": "0.1.0",
  "identifier": "dev.thuan.agentspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agentspace",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "publisher": "HUTECH",
    "copyright": "© HUTECH",
    "shortDescription": "Quản lý workspace và phiên Claude Code",
    "longDescription": "Agentspace — desktop app quản lý workspace, phiên, skill, memory và mức sử dụng cho Claude Code. Chạy chính binary claude đã cài trên máy bạn, bằng tài khoản của bạn.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "Vietnamese",
          "English"
        ]
      }
    }
  }
}