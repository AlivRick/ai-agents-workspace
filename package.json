{
  "name": "agentspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "check:paths": "node --experimental-strip-types src/paths.check.ts",
    "check:reorder": "node --experimental-strip-types src/reorder.check.ts",
    "check:limits": "node --experimental-strip-types src/limits.check.ts",
    "check:task": "node --experimental-strip-types src/task.check.ts",
    "check:agents": "node --experimental-strip-types src/agents.check.ts",
    "check:diff": "node --experimental-strip-types src/diff.check.ts",
    "release:win": "npm run tauri build -- --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis && bash scripts/ship-win.sh",
    "check:zoom": "node --experimental-strip-types src/zoom.check.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
